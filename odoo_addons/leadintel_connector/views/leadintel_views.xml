<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_leadintel_sync_log_list" model="ir.ui.view">
    <field name="name">leadintel.sync.log.list</field>
    <field name="model">leadintel.sync.log</field>
    <field name="arch" type="xml">
      <list>
        <field name="create_date"/>
        <field name="operation"/>
        <field name="lead_id"/>
        <field name="status"/>
        <field name="request_id"/>
        <field name="error_message"/>
      </list>
    </field>
  </record>

  <record id="view_leadintel_webhook_log_list" model="ir.ui.view">
    <field name="name">leadintel.webhook.log.list</field>
    <field name="model">leadintel.webhook.log</field>
    <field name="arch" type="xml">
      <list>
        <field name="received_at"/>
        <field name="event_id"/>
        <field name="event_type"/>
        <field name="status"/>
        <field name="error_message"/>
      </list>
    </field>
  </record>

  <record id="action_leadintel_sync_log" model="ir.actions.act_window">
    <field name="name">Sync Logs</field>
    <field name="res_model">leadintel.sync.log</field>
    <field name="view_mode">list</field>
  </record>
  <record id="action_leadintel_webhook_log" model="ir.actions.act_window">
    <field name="name">Webhook Logs</field>
    <field name="res_model">leadintel.webhook.log</field>
    <field name="view_mode">list</field>
  </record>
</odoo>
