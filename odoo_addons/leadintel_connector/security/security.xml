<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Odoo 19: groups use privilege_id → res.groups.privilege (category_id removed from res.groups) -->
  <record id="module_category_leadintel" model="ir.module.category">
    <field name="name">LeadIntel</field>
    <field name="sequence">50</field>
  </record>

  <record id="res_groups_privilege_leadintel" model="res.groups.privilege">
    <field name="name">LeadIntel</field>
    <field name="category_id" ref="module_category_leadintel"/>
    <field name="sequence">50</field>
  </record>

  <record id="group_leadintel_user" model="res.groups">
    <field name="name">User</field>
    <field name="privilege_id" ref="res_groups_privilege_leadintel"/>
  </record>
  <record id="group_leadintel_manager" model="res.groups">
    <field name="name">Manager</field>
    <field name="privilege_id" ref="res_groups_privilege_leadintel"/>
    <field name="implied_ids" eval="[(4, ref('group_leadintel_user'))]"/>
  </record>
  <record id="group_leadintel_admin" model="res.groups">
    <field name="name">Administrator</field>
    <field name="privilege_id" ref="res_groups_privilege_leadintel"/>
    <field name="implied_ids" eval="[(4, ref('group_leadintel_manager'))]"/>
    <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
  </record>
</odoo>
