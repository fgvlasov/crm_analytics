# Application
APP_ENV=local
APP_NAME=leadintel
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Security (change in any non-local env)
SECRET_KEY=change-me-dev-secret-key-min-32-chars!!
ENCRYPTION_MASTER_KEY=change-me-32byte-base64-or-passphrase!!
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Database
DATABASE_URL=postgresql+psycopg://leadintel:leadintel@localhost:5432/leadintel

# Redis
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=leadintel-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Seed (local/demo only)
SEED_DEMO=true
SEED_TENANT_SLUG=coldex-demo
SEED_TENANT_NAME=Coldex Demo
SEED_ADMIN_EMAIL=admin@coldex-demo.example
SEED_ADMIN_PASSWORD=ChangeMeDemo123!
SEED_ADMIN_NAME=Coldex Admin

# Feature flags — Phase 1 always on; phases 2–6 default off
FEATURE_ODOO_CONNECTOR=true
FEATURE_FAST_AI=false
FEATURE_DEEP_RESEARCH=false
FEATURE_SMART_RPT=false
FEATURE_WEB_NEWS_COLLECTORS=false
